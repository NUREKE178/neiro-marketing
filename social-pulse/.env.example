# =============================================================================
# Social Pulse — PRODUCTION .env.example
# NO secrets in repo. Generate values locally.
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/social_pulse?schema=public"
# Generate: use Neon/Supabase/Railway Postgres
# Example: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# --- Auth ---
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_-base64_32"
NEXTAUTH_URL="http://localhost:3000" # Production: https://yourdomain.com

# --- Encryption — AES-256-GCM key for tokens at rest ---
# Generate: openssl rand -base64 32
# Must be 32 bytes base64 = 44 chars. NEVER commit real key. NEVER send to client.
ENCRYPTION_KEY="REPLACE_WITH_openssl_rand_-base64_32_OUTPUT"

# --- Meta Graph API — Instagram ---
# Create app: https://developers.facebook.com/apps/
# Add products: Facebook Login, Instagram Graph API
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/oauth/instagram/callback"
# Scopes: instagram_basic, instagram_manage_insights, pages_show_list, pages_read_engagement
# Graph version: v19.0
# Data Deletion Callback URL to set in App Dashboard: https://yourdomain.com/api/data-deletion
META_DATA_DELETION_CALLBACK_TOKEN="optional_verify_token_for_deletion"

# --- TikTok Login Kit + Display API ---
# Create app: https://developers.tiktok.com/
# Add products: Login Kit, Display API
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/oauth/tiktok/callback"
# Scopes: user.info.basic, video.list
# IMPORTANT: Competitor tracking NOT allowed via Display API. Only own videos. NO Research API.

# --- Cron ---
CRON_SECRET="CHANGE_ME_generate_with_openssl_rand_-hex_16"
# Vercel Cron will send Authorization: Bearer <CRON_SECRET>

# --- Redis (optional, for prod locks) ---
# In dev, in-memory locks used. In prod, use Redis SET NX.
# Generate via Upstash/Redis Cloud
REDIS_URL="redis://localhost:6379"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# SECURITY: DEMO_MODE must be false in production. Build fails if true in prod.
NEXT_PUBLIC_DEMO_MODE="false"

# --- Optional AI (not required for core) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# =============================================================================
# HOW TO GENERATE SECRETS:
# openssl rand -base64 32  # for ENCRYPTION_KEY and NEXTAUTH_SECRET
# openssl rand -hex 16     # for CRON_SECRET
# =============================================================================

# =============================================================================
# META APP CREATION CHECKLIST:
# 1. Go https://developers.facebook.com/apps/ → Create App → Business type
# 2. Add Products: Facebook Login + Instagram Graph API
# 3. Facebook Login → Settings → Valid OAuth Redirect URIs: add META_REDIRECT_URI
# 4. Instagram Graph API → Add Instagram Testers or submit for App Review
# 5. Scopes needed: instagram_basic, instagram_manage_insights, pages_show_list, pages_read_engagement
# 6. Business Discovery: ONLY public fields, requires instagram_basic + IG User ID
# 7. Data Deletion Callback: set to https://yourdomain.com/api/data-deletion
# 8. Privacy Policy URL: https://yourdomain.com/privacy
# 9. Terms URL: https://yourdomain.com/terms
# 10. App Review: Provide screencast showing Login → Profile → Media → Insights flow
# 11. Personal account check: If isPersonalAccount=true, show guide to switch Creator/Business:
#     Settings → Account → Switch to Professional Account → Creator or Business
#
# TIKTOK APP CREATION CHECKLIST:
# 1. Go https://developers.tiktok.com/ → Manage apps → Create
# 2. Add Products: Login Kit + Display API
# 3. Login Kit → Set Redirect URI: TIKTOK_REDIRECT_URI
# 4. Scopes: user.info.basic, video.list (own videos only)
# 5. IMPORTANT: Display API does NOT allow competitor tracking. Own profile/videos only.
#    To track competitors, user must have explicit consent or use public Business Discovery via IG only.
# 6. App Review: Provide demo video + privacy policy URL
# 7. Webhook: not needed for MVP
# =============================================================================
