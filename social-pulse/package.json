{
  "name": "social-pulse",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "electron": "wait-on http://localhost:3000 && electron electron/main.js",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron electron/main.js\"",
    "electron:build": "next build && electron-builder --win --x64",
    "electron:build:win": "next build && electron-builder --win --x64 --config electron-builder.yml",
    "build:win": "npm run build && npm run electron:build:win",
    "pwa:build": "next build"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.4.6",
    "postcss": "^8.4.39",
    "autoprefixer": "^10.4.19",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.4.0",
    "lucide-react": "^0.408.0",
    "framer-motion": "^11.3.2",
    "recharts": "^2.12.7",
    "@tanstack/react-query": "^5.51.1",
    "zustand": "^4.5.4",
    "date-fns": "^3.6.0",
    "react-day-picker": "^8.10.1",
    "@prisma/client": "^5.16.2",
    "prisma": "^5.16.2",
    "zod": "^3.23.8",
    "next-auth": "^4.24.7",
    "next-pwa": "^5.6.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.socialpulse.desktop",
    "productName": "Social Pulse",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "directories": {
      "buildResources": "public"
    }
  }
}
