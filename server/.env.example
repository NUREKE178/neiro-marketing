# ---------------------------------------------------------------------------
# SESSION_SECRET — required for the marketer side of the app to work at
# all. Signs the "owner" session cookie that scopes "my tests" to this
# browser (no accounts/login system). Generate one: openssl rand -base64 32
# Viewers (the public /watch/:id page) need NO configuration — they never
# touch this cookie.
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# AI analysis (NeuroAnalysisService) — turns aggregated facial-reaction
# scores into a written verdict via the official Anthropic Messages API.
# Without this, results still show the raw numbers/chart, just without the
# AI-written summary — a clean "not configured" state, never a fake verdict.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional: override the model used for analysis.
AI_MODEL=claude-sonnet-5-5

PORT=8093

# Database. Leave both empty for local dev — falls back to an embedded
# SQLite file at server/data/neiro-marketing.sqlite. In production
# (Vercel), serverless functions have no persistent disk, so set these to a
# free Turso database (SQLite-compatible, https://turso.tech):
#   turso db create neiro-marketing
#   turso db show neiro-marketing --url          -> TURSO_DATABASE_URL
#   turso db tokens create neiro-marketing        -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
