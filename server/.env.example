# RapidAPI key, shared across the Instagram + TikTok adapters.
# Get one at https://rapidapi.com — subscribe to an Instagram scraper API and
# a TikTok scraper API, then paste your key below (X-RapidAPI-Key header).
RAPIDAPI_KEY=

# Optional: override if your subscribed product uses a different host than
# the defaults baked into server/src/providers/*.ts. Also re-check the
# map*() functions in those files against your product's actual response —
# see server/README.md.
RAPIDAPI_INSTAGRAM_HOST=instagram-scraper-stable-api.p.rapidapi.com
RAPIDAPI_TIKTOK_HOST=tiktok-scraper7.p.rapidapi.com

PORT=8093
