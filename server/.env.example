# ---------------------------------------------------------------------------
# Data source 1: RapidAPI (third-party, unauthenticated) — the only way to
# look up a PUBLIC ACCOUNT THAT ISN'T YOURS. Results are tagged
# "partially_verified" in the UI. See "Getting a RapidAPI key" below.
# ---------------------------------------------------------------------------
RAPIDAPI_KEY=

# Optional: override if your subscribed product uses different
# hosts/paths/param names than the defaults baked into
# server/src/providers/{instagram,tiktok}/rapidapi.ts. Also re-check the
# map*() functions in those files against your product's actual response —
# see server/README.md.
RAPIDAPI_INSTAGRAM_HOST=instagram-scraper-stable-api.p.rapidapi.com
RAPIDAPI_INSTAGRAM_PROFILE_PATH=/v1/info
RAPIDAPI_INSTAGRAM_POSTS_PATH=/v1/reels
RAPIDAPI_INSTAGRAM_USERNAME_PARAM=username_or_id_or_url

RAPIDAPI_TIKTOK_HOST=tiktok-scraper7.p.rapidapi.com
RAPIDAPI_TIKTOK_PROFILE_PATH=/user/info
RAPIDAPI_TIKTOK_POSTS_PATH=/user/posts
RAPIDAPI_TIKTOK_USERNAME_PARAM=unique_id

# ---------------------------------------------------------------------------
# Data source 2: official OAuth ("AuthorizedDataImport") — the account
# OWNER connects THEIR OWN account and that data is tagged "verified". This
# can NEVER return a third party's data; that's a Meta/TikTok platform
# restriction, not a limitation of this code. See "Setting up official
# OAuth" in server/README.md for how to register each app.
# ---------------------------------------------------------------------------

# Required for OAuth connect to work at all (signs the session cookie +
# encrypts stored tokens). Generate one: openssl rand -base64 32
SESSION_SECRET=

# The public base URL this server is reachable at — used to build the OAuth
# redirect_uri (${PUBLIC_APP_URL}/api/auth/{platform}/callback) and the
# post-login redirect back to the Settings page. Must exactly match what
# you register with Meta/TikTok.
#   local dev:   http://localhost:5173   (through the Vite proxy to :8093)
#   Vercel prod: https://your-app.vercel.app
PUBLIC_APP_URL=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

PORT=8093

# Database. Leave both empty for local dev — falls back to an embedded
# SQLite file at server/data/neiro-marketing.sqlite. In production
# (Vercel), serverless functions have no persistent disk, so set these to a
# free Turso database (SQLite-compatible, https://turso.tech):
#   turso db create neiro-marketing
#   turso db show neiro-marketing --url          -> TURSO_DATABASE_URL
#   turso db tokens create neiro-marketing        -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
